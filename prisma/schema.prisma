generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemCategory {
  MAIN_COURSE
  DESSERT
  DRINK
  APPETIZER
  SIDE_DISH
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MenuItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  slug        String  @unique
  price       Decimal @db.Decimal(10, 2)

  category ItemCategory

  imageUrl  String?
  available Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu   Menu?   @relation(fields: [menuId], references: [id])
  menuId String?

  menuItemTranslations MenuItemTranslation[]
  orderItems           OrderItem[]
}

model Menu {
  id   String @id @default(cuid())
  name String
  slug String @unique

  items            MenuItem[]
  menuTranslations MenuTranslation[]
}

model MenuTranslation {
  id String @id @default(cuid())

  language String
  name     String

  menu   Menu   @relation(fields: [menuId], references: [id])
  menuId String

  @@unique([language, menuId])
}

model MenuItemTranslation {
  id String @id @default(cuid())

  language    String
  name        String
  description String?

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String

  @@unique([language, menuItemId])
}

model Table {
  id        String  @id @default(cuid())
  number    Int
  available Boolean @default(true)

  order Order[]
}

model Order {
  id     String      @id @default(cuid())
  total  Decimal     @db.Decimal(10, 2)
  status OrderStatus @default(PENDING)

  tableId String
  table   Table  @relation(fields: [tableId], references: [id])

  orderItems OrderItem[]
}

model OrderItem {
  id String @id @default(cuid())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String

  quantity Int
}
